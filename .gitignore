# Byteforce VoicePulse AI - Official .gitignore for Hackathon Submission
# Compliant with TalentAP Participant Coding Guidelines v1.1

# Environment & Secrets (Rule 3)
.env
*.env
*.key
*.token

# Virtual Environments (Rule 2 & Rule 5)
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Python cache & build artifacts (Rule 7)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Linting caches
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/

# IDE & Editor metadata
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Large datasets & models (Rule 5)
data/
models/
*.bin
*.tar.gz
*.7z

# Video recordings & heavy temporary media
demo_video/
pdf_renders/
slide_renders/
*.mp4
*.webm
*.avi
*.wav

# Nested archives
*.zip
