# VoicePulse AI - Environment Configuration Example
# Copy this file to .env and customize as needed. Never commit your real .env.

# Application Server Settings
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# Logging & Operational Thresholds
VOICEPULSE_LOG_LEVEL=INFO
RADAR_SURGE_THRESHOLD=1.75
RADAR_MIN_TRANSACTIONS=500
CLASSIFIER_CONFIDENCE_THRESHOLD=0.30

# Optional External API Keys (if using cloud LLM augmentations)
# OPENAI_API_KEY=dummy_key_not_required_for_offline_engine
# ANTHROPIC_API_KEY=dummy_key_not_required_for_offline_engine
